# Open-AutoGLM AI Service Configuration

# Model Backend Configuration
# Option 1: Using Remote API (e.g. Zhipu AI / OpenAI)
PHONE_AGENT_BASE_URL=https://open.bigmodel.cn/api/paas/v4/
PHONE_AGENT_API_KEY=
PHONE_AGENT_MODEL=autoglm-phone

# Option 2: Using Local vLLM (Ensure vLLM serves on this URL)
# PHONE_AGENT_BASE_URL=http://localhost:8000/v1
# PHONE_AGENT_API_KEY=EMPTY
# PHONE_AGENT_MODEL=autoglm-phone-9b

# Server Configuration
OPEN_AUTOGLM_PORT=10001

# Note: If running inside Docker or separate container, use valid IP address instead of localhost.
# Note: For real phone control, ensure ADB is running and device is authorized.

